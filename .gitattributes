# Fixed-width molecular formats intentionally contain padded columns.
*.pdb text eol=lf whitespace=-blank-at-eol
*.sdf text eol=lf whitespace=-blank-at-eol
*.sh text eol=lf
*.py text eol=lf
*.mol text eol=lf whitespace=-blank-at-eol
# Preserve the exact generated force-field audit, including its terminal separator.
*.frcmod text eol=lf whitespace=-blank-at-eof
